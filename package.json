{
  "name": "happy-singing-kids-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@next/third-parties": "^14.2.4",
    "@stripe/react-stripe-js": "^1.1.2",
    "@stripe/stripe-js": "^1.5.0",
    "animate.css": "^4.1.0",
    "classnames": "^2.2.6",
    "next": "14.2.4",
    "query-string": "^6.13.0",
    "react": "^18",
    "react-animate-on-scroll": "^2.1.5",
    "react-dom": "^18",
    "serverless": "^4.4.16"
  },
  "scripts": {
    "info": "serverless info",
    "predev": "cp .env.dev .env.local",
    "dev": "next dev -p 8080",
    "start": "yarn build:dev && serve -l 8080 out",
    "build:dev": "cp .env.dev .env.local && yarn build",
    "build:prod": "cp .env.prod .env.local && yarn build",
    "build": "next build && node ./bin/minify-images",
    "start:dev": "cp .env.dev .env.local && yarn start",
    "start:prod": "cp .env.prod .env.local && yarn start",
    "predeploy:dev": "yarn build:dev",
    "deploy:dev": "serverless deploy --stage dev",
    "predeploy:prod": "yarn build:prod",
    "deploy:prod": "serverless deploy --stage prod",
    "test": "cypress run e2e",
    "test:dev": "CYPRESS_VARIANT=dev cypress run e2e",
    "test:prod": "CYPRESS_VARIANT=prod cypress run e2e",
    "test:next": "next test",
    "cypress:open": "cypress open",
    "destroy": "serverless remove"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^7.10.1",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^10.0.0",
    "@testing-library/react-hooks": "^3.3.0",
    "@testing-library/user-event": "^7.1.2",
    "@types/classnames": "^2.2.10",
    "@types/jest": "^25.2.3",
    "@types/node": "^12.0.0",
    "@types/react": "^16.9.0",
    "@types/react-animate-on-scroll": "^2.1.2",
    "@types/react-dom": "^16.9.0",
    "@types/react-ga": "^2.3.0",
    "@types/react-router-dom": "^5.1.3",
    "cypress": "^13.17.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-plugin-next": "^0.0.0",
    "react-test-renderer": "^16.13.1",
    "sass": "^1.77.6",
    "serve": "^14.2.4",
    "serverless-lift": "^1.29.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.16",
    "ts-jest": "^26.1.0",
    "typescript": "^5"
  },
  "jest2": {
    "transform": {
      ".(ts|tsx)": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ]
  }
}
