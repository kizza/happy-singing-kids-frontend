{
  "name": "happy-singing-kids-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@next/third-parties": "^16.2.4",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.3.1",
    "animate.css": "^4.1.1",
    "classnames": "^2.5.1",
    "next": "16.2.4",
    "posthog-js": "^1.372.3",
    "query-string": "^9.3.1",
    "react": "^19",
    "react-animate-on-scroll": "^2.1.9",
    "react-dom": "^19",
    "serverless": "^4.34.0"
  },
  "scripts": {
    "info": "serverless info",
    "predev": "cp .env.dev .env.local",
    "dev": "next dev -p 8080",
    "start": "yarn build:dev && serve -l 8080 out",
    "build:dev": "cp .env.dev .env.local && yarn build",
    "build:prod": "cp .env.prod .env.local && yarn build",
    "build": "next build && node ./bin/minify-images",
    "start:dev": "cp .env.dev .env.local && yarn start",
    "start:prod": "cp .env.prod .env.local && yarn start",
    "predeploy:dev": "yarn build:dev",
    "deploy:dev": "serverless deploy --stage dev",
    "predeploy:prod": "yarn build:prod",
    "deploy:prod": "serverless deploy --stage prod",
    "test": "cypress run e2e",
    "test:dev": "CYPRESS_VARIANT=dev cypress run e2e",
    "test:prod": "CYPRESS_VARIANT=prod cypress run e2e",
    "test:next": "next test",
    "cypress:open": "cypress open",
    "destroy": "serverless remove"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/classnames": "^2.3.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-animate-on-scroll": "^2.1.8",
    "@types/react-dom": "^19.2.3",
    "@types/react-ga": "^2.3.0",
    "@types/react-router-dom": "^5.3.3",
    "cypress": "^15.14.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.2.1",
    "eslint-plugin-next": "^0.0.0",
    "react-test-renderer": "^19.2.5",
    "sass": "^1.99.0",
    "serve": "^14.2.6",
    "serverless-lift": "^1.35.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6"
  },
  "jest2": {
    "transform": {
      ".(ts|tsx)": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ]
  }
}
